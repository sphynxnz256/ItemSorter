{
    "name": "ItemSorter - ROS 2 Jazzy",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "ros_user",
            "USER_UID": "1000",
            "USER_GID": "1000"
        },
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "ms-python.python"
            ]
        }
    },
    "remoteUser": "ros_user",
    "containerEnv": {
        "DISPLAY": "host.docker.internal:0"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ItemSorter,type=bind",
    "workspaceFolder": "/workspaces/ItemSorter"
}