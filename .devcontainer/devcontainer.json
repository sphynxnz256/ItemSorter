{
    "name": "ItemSorter - ROS 2 Jazzy",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "ros_user",
            "USER_UID": "1000",
            "USER_GID": "1000"
        },
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ranch-hand-robotics.rde-pack",
                "ranch-hand-robotics.urdf-editor",
                "ranch-hand-robotics.rde-ros-2",
                "ms-vscode.cpptools",
                "ms-python.python",
                "redhat.vscode-yaml",
                "njpwerner.autodocstring"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.analysis.extraPaths": [
                    "/opt/ros/jazzy/lib/python3.12/site-packages"
                ]
            }
        }
    },
    "remoteUser": "ros_user",
    "containerEnv": {
        "DISPLAY": "host.docker.internal:0",
        "NVM_DIR": "/usr/local/nvm"
    },
    "runArgs": [
        "--privileged",
        "--init"
    ],
    "overrideCommand": true,
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ItemSorter,type=bind",
    "workspaceFolder": "/workspaces/ItemSorter"    
}